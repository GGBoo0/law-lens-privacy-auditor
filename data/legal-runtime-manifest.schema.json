{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/GGBoo0/law-lens-privacy-auditor/main/data/legal-runtime-manifest.schema.json",
  "title": "LawLens legal runtime manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "asOfDate",
    "snapshotCapturedAt",
    "rulesetVersion",
    "registryReviewedAt",
    "sourceCount",
    "reviewedVersions",
    "pendingChanges",
    "pendingCount",
    "effectivePendingCount",
    "nextReviewRequiredBy"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "asOfDate": { "type": "string", "format": "date" },
    "snapshotCapturedAt": { "type": "string", "format": "date-time" },
    "rulesetVersion": { "type": "string", "minLength": 1 },
    "registryReviewedAt": { "type": "string", "format": "date" },
    "sourceCount": { "type": "integer", "minimum": 0 },
    "reviewedVersions": {
      "type": "array",
      "items": { "$ref": "#/$defs/reviewedVersion" }
    },
    "pendingChanges": {
      "type": "array",
      "items": { "$ref": "#/$defs/pendingChange" }
    },
    "pendingCount": { "type": "integer", "minimum": 0 },
    "effectivePendingCount": { "type": "integer", "minimum": 0 },
    "nextReviewRequiredBy": {
      "oneOf": [{ "type": "string", "format": "date" }, { "type": "null" }]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "reviewedVersion": {
      "type": "object",
      "required": ["sourceId", "versionId", "documentHash", "effectiveDate", "outcome"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "versionId": { "type": "string", "minLength": 1 },
        "documentHash": { "type": "string", "minLength": 1 },
        "effectiveDate": { "type": "string", "format": "date" },
        "outcome": {
          "enum": ["rule_updated", "no_analyzer_impact", "superseded"]
        }
      },
      "additionalProperties": false
    },
    "pendingChange": {
      "type": "object",
      "required": [
        "changeId",
        "sourceId",
        "versionId",
        "documentHash",
        "hashAlgorithm",
        "name",
        "version",
        "effectiveFrom",
        "effectiveDateUnknown",
        "detectedAt",
        "changeKind",
        "status",
        "url",
        "impactCategories",
        "review",
        "officialState",
        "observation",
        "firstObservedAt",
        "lastObservedAt"
      ],
      "properties": {
        "changeId": { "type": "string", "minLength": 1 },
        "sourceId": { "type": "string", "minLength": 1 },
        "versionId": { "type": "string", "minLength": 1 },
        "documentHash": { "type": "string", "minLength": 1 },
        "hashAlgorithm": {
          "enum": [
            "legal-semantic-text-v1",
            "legal-semantic-text-v2",
            "legacy-document-hash",
            "source-fingerprint"
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "effectiveFrom": { "type": "string", "format": "date" },
        "effectiveDateUnknown": { "type": "boolean" },
        "detectedAt": { "type": "string", "format": "date-time" },
        "changeKind": { "const": "semantic" },
        "status": { "type": "string", "minLength": 1 },
        "url": { "type": "string" },
        "impactCategories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "core_disclosures",
              "data_subject_rights",
              "data_portability",
              "third_party_provision",
              "outsourcing",
              "cross_border_transfer",
              "cookies_behavioral",
              "security_measures",
              "privacy_officer",
              "policy_transparency",
              "special_categories",
              "ai_transparency",
              "automated_decision",
              "location_information",
              "credit_information",
              "ecommerce_retention"
            ]
          }
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "reviewedAt",
            "reviewedRulesetVersion",
            "outcome"
          ],
          "properties": {
            "status": { "const": "pending" },
            "reviewedAt": { "type": "null" },
            "reviewedRulesetVersion": { "type": "null" },
            "outcome": { "type": "null" }
          },
          "additionalProperties": false
        },
        "officialState": { "type": "string" },
        "observation": { "enum": ["observed", "not_observed"] },
        "firstObservedAt": { "type": "string", "format": "date-time" },
        "lastObservedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
